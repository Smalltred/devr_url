# ===================================================================
# devr 短链服务环境变量示例
# 复制为 .env 并按实际情况填写；.env 不要提交到 Git。
# Node 后端会依次加载 backend/.env 与项目根目录 .env（真实环境变量优先）。
# ===================================================================

# ---------- 后端（backend/）----------

# local / testing / production
APP_ENV=production
# 生产环境必须为 false，避免异常细节泄露
APP_DEBUG=false
# 站点对外地址：为 https 时登录 Cookie 附带 Secure
APP_URL=http://localhost:3001
# 构建时写入 canonical / Open Graph / sitemap 的绝对地址（必须是 https）
# 未配置时优先沿用 APP_URL（仅当其协议为 https），否则回退到 https://devr.cn
VITE_SITE_URL=https://devr.cn
# 本地开发监听端口（node src/server.js）
APP_PORT=3001

# ---------- SQLite（backend/）----------

# 短链数据库文件路径，留空使用默认值 backend/storage/short-url.sqlite3
# 自定义示例：DATABASE_PATH=/data/short-url.sqlite3
DATABASE_PATH=

# ---------- 管理后台（backend/）----------

# 单管理员账号；生产环境务必修改默认密码！
# 也可登录 /admin 后台「设置」页直接修改密码（落库优先于本配置）
ADMIN_USERNAME=admin
# 明文密码（默认 admin123）；设置 ADMIN_PASSWORD_HASH 后此项失效
ADMIN_PASSWORD=
# 推荐：密码哈希。Node 版兼容 PHP bcrypt 哈希，生成方式：
#   node -e "console.log(require('bcryptjs').hashSync('你的密码',10))"
# （存量 PHP 部署写入的 $2y$ 哈希仍然有效，无需重置密码）
ADMIN_PASSWORD_HASH=
# 登录态有效期（天）
ADMIN_TOKEN_TTL_DAYS=7

# ---------- 安全（backend/）----------

# 允许的跨站写操作来源（逗号分隔），留空 = 仅接受同源请求（推荐）
# 仅当前端与后端跨域部署（VITE_API_BASE_URL 非空）时才需要填写后端信任的前端源
ALLOWED_ORIGINS=

# 写请求缺少 Origin/Referer 时是否放行；默认 false（拒绝跨站写操作）
# 仅当集成方用非浏览器客户端且无法补头发送时，才设为 true
CSRF_ALLOW_MISSING_ORIGIN=false

# IP 匿名哈希密钥（推荐设置一个足够随机的值）：
# 设置后改用 HMAC-SHA256，密钥不随数据库存储，库文件泄露也无法反推原始 IP。
# 注意：修改该值会使历史独立访客统计从零重新累计。
IP_HASH_SECRET=

# 请求体上限（字节），超出返回 413；默认 16384
MAX_BODY_BYTES=16384

# 创建短链限流：同一 IP 在窗口（秒）内允许的创建请求数；0 = 关闭
CREATE_RATE_LIMIT_MAX=60
CREATE_RATE_LIMIT_WINDOW=60

# 是否保存完整 Referer（含路径与查询串）。默认 false 仅保存来源域名，
# 避免把来源页查询串中的 token 等敏感参数长期留存
PRIVACY_STORE_REFERER=false

# 反向代理：默认信任来自回环/私网地址的 X-Real-IP / X-Forwarded-For，
# 用于记录创建者真实 IP 与创建限流。应用直接暴露公网时设为 false
TRUST_PROXY=true

# HTTP 严格传输安全（HSTS）有效期（秒）；0 = 不下发
# 确认全站 HTTPS 后再设为 31536000
HSTS_MAX_AGE=0

# 统计脚本域名（CSP script-src 放行；留空时默认放行 Google Analytics）
CSP_SCRIPT_EXTRA=
# 跨域部署时把后端源加入 CSP connect-src，例如 https://api.example.com
CSP_CONNECT_EXTRA=

# ---------- 缓存（backend/）----------

# 短链跳转缓存驱动：memcached（默认）| none（关闭）
# 服务不可用时自动降级为直连数据库，跳转不受影响
CACHE_DRIVER=memcached
# memcached 服务地址（逗号分隔 host:port）
# 单容器部署为 127.0.0.1:11211（默认）；docker compose 三容器部署设为 memcached:11211
MEMCACHED_SERVERS=
# 命中缓存有效期（秒），0 = 不缓存；后台「设置」页可覆盖
CACHE_TTL=300
# 负缓存：缓存“短码不存在”的时长（秒），抵御公网扫描流量；0 = 关闭
CACHE_NEGATIVE_TTL=30
# 连接/读写超时（毫秒）：宁可穿透数据库，也不让缓存拖慢跳转
MEMCACHED_TIMEOUT_MS=200

# ---------- 外链巡检（backend/）----------

# 检测短链目标地址是否仍可访问（403/404/超时等记为失效）。
# 单次探测超时（秒），以及建连超时（秒）
HEALTH_TIMEOUT_SECONDS=8
HEALTH_CONNECT_TIMEOUT_SECONDS=5
# 复检间隔（小时）：同一短链在该时间内不重复检测
HEALTH_STALE_HOURS=24
# 每批扫描条数（手动扫描的批大小 / 定时任务单批上限）
HEALTH_BATCH_SIZE=20
# 每日定时巡检（进程内调度，无需外部 cron）：默认每天 12:00（北京时间 UTC+8）
# 具体时刻与阈值可在后台「设置」页修改，改完无需重启
HEALTH_SCAN_ENABLED=true
HEALTH_SCAN_HOUR=12
HEALTH_SCAN_MINUTE=0
# 连续失败多少次判定为失效（1-10，后台可改）
HEALTH_DEAD_THRESHOLD=3

# ---------- Vue 前端（Vite 构建时读取）----------

# 留空 = 与前端同源（推荐，配合 Nginx 把 /url、/api、短码路由反代到 Node）
# 跨域部署示例：VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
