# ===================================================================
# short-url 环境变量示例
# 复制为 .env 并按实际情况填写；.env 不要提交到 Git。
# PHP 后端会依次尝试加载 backend/.env 与项目根目录 .env。
# ===================================================================

# ---------- PHP 后端（backend/）----------

# local / testing / production
APP_ENV=production
# 生产环境必须为 false，避免异常细节泄露
APP_DEBUG=false
# 站点对外地址（用于未来扩展，当前跳转逻辑不依赖它）
APP_URL=http://localhost:3001
# 本地开发时 PHP 内置服务器端口（composer serve）
APP_PORT=3001

# ---------- SQLite（backend/）----------

# 短链数据库文件路径，留空使用默认值 backend/storage/short-url.sqlite3
# 自定义示例：DATABASE_PATH=/data/short-url.sqlite3
DATABASE_PATH=

# ---------- 管理后台（backend/）----------

# 单管理员账号；生产环境务必修改默认密码！
# 也可登录 /admin 后台「设置」页直接修改密码（落库优先于本配置）
ADMIN_USERNAME=admin
# 明文密码（默认 admin123）；设置 ADMIN_PASSWORD_HASH 后此项失效
ADMIN_PASSWORD=
# 推荐：密码哈希，生成方式 php -r "echo password_hash('你的密码', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=
# 登录态有效期（天）
ADMIN_TOKEN_TTL_DAYS=7

# ---------- 安全（backend/）----------

# 允许的跨站写操作来源（逗号分隔），留空 = 仅接受同源请求（推荐）
# 仅当前端与后端跨域部署（VITE_API_BASE_URL 非空）时才需要填写后端信任的前端源
ALLOWED_ORIGINS=

# 写请求缺少 Origin/Referer 时是否放行；默认 false（拒绝跨站写操作）
# 仅当集成方用非浏览器客户端且无法补头发送时，才设为 true
CSRF_ALLOW_MISSING_ORIGIN=false

# IP 匿名哈希密钥（推荐设置一个足够随机的值）：
# 设置后改用 HMAC-SHA256，密钥不随数据库存储，库文件泄露也无法反推原始 IP。
# 注意：修改该值会使历史独立访客统计从零重新累计。
IP_HASH_SECRET=

# 请求体上限（字节），超出返回 413；默认 16384
MAX_BODY_BYTES=16384

# 创建短链限流：同一 IP 在窗口（秒）内允许的创建请求数；0 = 关闭
CREATE_RATE_LIMIT_MAX=60
CREATE_RATE_LIMIT_WINDOW=60

# 是否保存完整 Referer（含路径与查询串）。默认 false 仅保存来源域名，
# 避免把来源页查询串中的 token 等敏感参数长期留存
PRIVACY_STORE_REFERER=false

# HTTP 严格传输安全（HSTS）有效期（秒）；0 = 不下发
# 确认全站 HTTPS 后再设为 31536000
HSTS_MAX_AGE=0

# 统计脚本域名（CSP script-src 放行；留空时默认放行 Google Analytics）
CSP_SCRIPT_EXTRA=
# 跨域部署时把后端源加入 CSP connect-src，例如 https://api.example.com
CSP_CONNECT_EXTRA=

# ---------- Vue 前端（Vite 构建时读取）----------

# 留空 = 与前端同源（推荐，配合 Nginx 把 /url、/api、短码路由反代到 PHP）
# 跨域部署示例：VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
